# --- LLM (classifier + question generator) ---------------------------------
# "openai" or "xai". Both speak the same wire format; this only picks the
# defaults below. Any other OpenAI-compatible endpoint works too — pick either
# provider and override LLM_BASE_URL + LLM_MODEL.
#
#   openai -> https://api.openai.com/v1   gpt-4o
#   xai    -> https://api.x.ai/v1         grok-4      (key from console.x.ai)
#
# NOTE: XAI_API_KEY (xAI/Grok, console.x.ai) is a different credential from
# X_API_KEY (X/Twitter, developer.x.com). Same founder, unrelated APIs.
LLM_PROVIDER=openai

# Optional. Defaults to OPENAI_API_KEY when provider=openai, XAI_API_KEY when xai.
LLM_API_KEY=
# Optional. Override to use any other OpenAI-compatible endpoint or model.
LLM_BASE_URL=
LLM_MODEL=

# --- Embeddings (vector database) ------------------------------------------
# Always OpenAI — xAI has no embeddings endpoint.
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- API auth ---------------------------------------------------------------
# Bearer token for every endpoint except /health. Same header convention as
# the xpred Worker: Authorization: Bearer <ADMIN_TOKEN>
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# The service refuses to start with no token unless this is set to 1.
ALLOW_UNAUTHENTICATED=0

# --- Storage backend --------------------------------------------------------
# "sqlite" (default, local file) or "supabase" (Postgres + pgvector).
STORE_BACKEND=sqlite

# Supabase. The publishable/anon key is READ-ONLY here — RLS blocks writes — so
# the service needs the service_role key from Dashboard -> Settings -> API.
# Run sql/001_market_embeddings.sql once before switching the backend over.
SUPABASE_URL=
# Direct Postgres connection — ONLY needed to run migrations (DDL).
# Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use port 5432 (session pooler), not 6543. Contains the DB password.
DATABASE_URL=

SUPABASE_SERVICE_KEY=

# --- Storage ----------------------------------------------------------------
DB_PATH=data/markets.db

# --- Dedup tuning -----------------------------------------------------------
# How many nearest markets to pull back from the vector store.
RECALL_K=8
# Below this cosine similarity a market is never even shown to the judge.
CANDIDATE_FLOOR=0.55
# At or above this similarity we call it a duplicate without spending an LLM call.
AUTO_DUPLICATE_THRESHOLD=0.97
# Set to 0 to run pure-threshold dedup (no LLM judge).
JUDGE_ENABLED=1

# --- Classifier tuning ------------------------------------------------------
# Clusters with less total engagement than this are WAIT, never CREATE.
MIN_ENGAGEMENT=500

# --- Grounding --------------------------------------------------------------
# Verifies a proposed market against the posts it came from before it can be
# created. The date check is a text scan (no LLM call); only dates that are
# absent from or contradicted by the posts escalate to an evidence check.
GROUNDING_ENABLED=1
# 1 = an unverifiable claim blocks the market. 0 = it is allowed through.
GROUNDING_STRICT=1

# --- Resolution -------------------------------------------------------------
# 0 (default) sends every due market to a human. 1 lets the LLM settle the ones
# it confidently knows. A plain chat model has no live data and will honestly
# answer UNKNOWN for anything past its cutoff, so expect a low auto-settle rate
# until this points at a model with live retrieval or a real scores feed.
AUTO_SETTLE=0
# Minimum confidence to settle without a human. Below this it goes to review.
AUTO_SETTLE_CONFIDENCE=0.9
