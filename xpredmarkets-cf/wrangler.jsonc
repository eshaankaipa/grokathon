{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xpredmarkets-cf",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "routes": [
    "xpred.aidenhuang.com/*"
  ],

  "vars": {
    "BOT_USERNAME": "XPredMarkets",
    "BOT_NAME": "X Prediction Markets"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xpredmarkets-db",
      "database_id": "3f7db08a-af6a-4d10-897d-d4747ed1529f",
      "migrations_dir": "./migrations"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Bundle Inter TTF for OG PNG text rendering (resvg has no system fonts)
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    }
  ]
}
